{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codify",
  "version": "0.1.0",
  "identifier": "dev.jorelcb.codify",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "codify",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
